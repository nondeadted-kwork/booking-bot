# Токен от @BotFather
BOT_TOKEN=123456789:AAAA-your-token

# Ваш Telegram id (узнать: @userinfobot). Несколько id через запятую.
OWNER_IDS=123456789

# 1: демо-режим. Панель владельца видят все, чужие имена скрыты, создаются демо-барберы и демо-записи.
DEMO_MODE=1

# Токен платёжного провайдера: @BotFather → /mybots → бот → Payments → ЮKassa (тест).
# Тест без регистрации: PayMaster → Connect PayMaster TEST, карта 4100 0000 0000 0001.
# Пусто: онлайн-оплата выключена, запись с оплатой на месте.
PAYMENT_TOKEN=
TEST_CARD_HINT=1111 1111 1111 1026, срок 12/30, CVC 000

BUSINESS_NAME=Барбершоп «Лезвие»
BUSINESS_ADDRESS=Москва, ул. Примерная, 1
BUSINESS_PHONE=+7 900 000-00-00
TZ_NAME=Europe/Moscow
REMIND_BEFORE_MIN=60
DB_PATH=data/bot.db
